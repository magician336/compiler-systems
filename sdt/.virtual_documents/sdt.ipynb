    # 请在每个产生式右部的花括号 {} 内填入语义规则
    # 格式：左部非终结符属性 = 右部符号属性计算
    # 例如：expr.t = expr1.t + term.t + '+'
    "expr -> expr1 + term { expr.t =  }",
    "expr -> expr1 - term { expr.t =  }",
    "expr -> term { expr.t =  }",
    "term -> term1 * factor { term.t =  }",
    "term -> term1 / factor { term.t =  }",
    "term -> factor { term.t =  }",
    "factor -> digit { factor.t =  }",
    "factor -> ( expr ) { factor.t =  }",
    "digit -> 0 { digit.t =  }",
